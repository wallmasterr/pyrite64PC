# Dreamcast build for Pyrite64 — generated by editor
# Requires KallistiOS (KOS_BASE) and n64/runtime_dc

PYRITE64_ROOT := {{PYRITE64_ROOT}}
P64_PROJECT_PATH := {{PROJECT_PATH}}
P64_ROM_NAME := {{ROM_NAME}}
OUTDIR := $(P64_PROJECT_PATH)/build-dc

RUNTIME_DC := $(PYRITE64_ROOT)/n64/runtime_dc

.PHONY: all clean

all:
	@if [ -z "$$KOS_BASE" ]; then \
		echo "error: KOS_BASE is not set. Source KallistiOS environ.sh first."; \
		exit 1; \
	fi
	@if [ ! -f "$(RUNTIME_DC)/Makefile" ]; then \
		echo "error: Dreamcast runtime missing at $(RUNTIME_DC)"; \
		exit 1; \
	fi
	$(MAKE) -C "$(RUNTIME_DC)" \
		P64_PROJECT_PATH="$(P64_PROJECT_PATH)" \
		P64_ROM_NAME="$(P64_ROM_NAME)" \
		PYRITE64_ROOT="$(PYRITE64_ROOT)" \
		OUTDIR="$(OUTDIR)" \
		all

clean:
	@if [ -f "$(RUNTIME_DC)/Makefile" ]; then \
		$(MAKE) -C "$(RUNTIME_DC)" clean \
			P64_PROJECT_PATH="$(P64_PROJECT_PATH)" \
			P64_ROM_NAME="$(P64_ROM_NAME)" \
			PYRITE64_ROOT="$(PYRITE64_ROOT)" \
			OUTDIR="$(OUTDIR)"; \
	fi
