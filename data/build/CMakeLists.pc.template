# PC build (GLES2) for Pyrite64 project - generated by editor
cmake_minimum_required(VERSION 3.16)
project({{ROM_NAME}}_pc LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)

set(PYRITE64_ROOT "{{PYRITE64_ROOT}}" CACHE PATH "Pyrite64 editor root")
set(P64_PROJECT_PATH "{{PROJECT_PATH}}" CACHE PATH "Project path")
set(P64_ROM_NAME "{{ROM_NAME}}" CACHE STRING "ROM/output name")

file(GLOB P64_GAME_SOURCES "${P64_PROJECT_PATH}/src/user/*.cpp" "${P64_PROJECT_PATH}/src/user/systems/*.cpp" "${P64_PROJECT_PATH}/src/p64/*.cpp")
add_subdirectory(${PYRITE64_ROOT}/n64/runtime_pc runtime_pc)
if(P64_GAME_SOURCES)
  target_sources(p64_pc_runtime PRIVATE ${P64_GAME_SOURCES})
  target_include_directories(p64_pc_runtime PRIVATE ${P64_PROJECT_PATH}/src ${PYRITE64_ROOT}/n64/engine/include)
endif()
